{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lohnbetrieb-Simulation",
  "version": "0.1.0",
  "identifier": "de.lohnbetrieb.simulation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lohnbetrieb-Simulation",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/map/": "map/"
    },
    "category": "SimulationGame",
    "shortDescription": "Managementspiel für ein Agrar-Lohnunternehmen",
    "copyright": "Kartendaten © OpenStreetMap-Mitwirkende (ODbL)",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
